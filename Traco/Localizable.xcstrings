            "value": "deleted."
          }
        }
      }
    },
    "as notas não abriram. nada do que você escrever agora fica. feche o app e abra de novo; se continuar assim, o backup está no app Arquivos › Traço.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the notes didn't open. nothing you write now will stay. close the app and open it again; if it keeps happening, the backup is in the Files app › Traço."
          }
        }
      }
    },
    "conectada — o Grok é o motor, pago pela sua assinatura.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "connected — Grok is the engine, paid by your subscription."
          }
        }
      }
    },
